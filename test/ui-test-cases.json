[
  {
    "name": "Level 4 task types",
    "input": [
      "todo borrow book",
      "deadline submit report /by Friday 5pm",
      "event project meeting /from Monday 2pm /to 4pm",
      "list",
      "bye"
    ],
    "expected": [
      "[T][ ] borrow book",
      "[D][ ] submit report (by: Friday 5pm)",
      "[E][ ] project meeting (from: Monday 2pm to: 4pm)"
    ]
  },
  {
    "name": "Mark and unmark",
    "input": ["todo read book", "mark 1", "list", "unmark 1", "list", "bye"],
    "expected": ["[T][X] read book", "[T][ ] read book"]
  },
  {
    "name": "Invalid commands do not change tasks",
    "input": [
      "todo",
      "todo read book",
      "blah",
      "deadline report",
      "event meeting",
      "mark x",
      "list",
      "bye"
    ],
    "expected": [
      "Baa-error: a task description cannot be empty.",
      "Baa-error: I don't recognize that command.",
      "Baa-error: a deadline needs a description and a /by date or time.",
      "Baa-error: an event needs a description, /from time, and /to time.",
      "Baa-error: the task number must be a whole number.",
      "1.[T][ ] read book"
    ]
  },
  {
    "name": "Delete tasks and renumber",
    "input": [
      "todo first task",
      "todo second task",
      "todo third task",
      "mark 2",
      "delete 1",
      "list",
      "delete x",
      "bye"
    ],
    "expected": [
      "Noted. I've removed this task:",
      "  [T][ ] first task",
      "1.[T][X] second task",
      "2.[T][ ] third task",
      "Baa-error: the task number must be a whole number."
    ]
  },
  {
    "name": "Level 7 save changes",
    "input": ["todo saved task", "mark 1", "delete 1", "bye"],
    "expected": [
      "Got it. I've added this task:",
      "Nice! I've marked this task as done:",
      "Noted. I've removed this task:"
    ]
  }
]
